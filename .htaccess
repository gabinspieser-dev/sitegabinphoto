# Copie officielle OVH : https://gabin-spieser.fr/
# Les redirections ne concernent que ce domaine, pas les apercus locaux.
# Le certificat SSL doit couvrir gabin-spieser.fr et www.gabin-spieser.fr.

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP_HOST} ^www\.gabin-spieser\.fr$ [NC]
    RewriteRule ^ https://gabin-spieser.fr%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^gabin-spieser\.fr$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteRule ^ https://gabin-spieser.fr%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^gabin-spieser\.fr$ [NC]
    RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
    RewriteRule ^index\.html$ https://gabin-spieser.fr/ [R=301,L,NE]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|xml|txt)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(woff2|webp|png|svg)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
