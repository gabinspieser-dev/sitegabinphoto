Options -Indexes
AddDefaultCharset UTF-8
# Official site: https://gabin-spieser.com/
# SSL must cover both gabin-spieser.com and www.gabin-spieser.com before deployment.
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
 RewriteEngine On
 # Never expose Git metadata or private dot files.
 RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
 # Données et outils du portfolio : jamais servis en ligne.
 RewriteRule ^_portfolio(?:/|$) - [F,L]
 # « Portfolio » est devenu « Séries » (25/11/2026) : les anciennes adresses mènent aux nouvelles.
 RewriteRule ^portfolio\.html$ /series/ [R=301,L]
 RewriteRule ^portfolio/(.*)$ /series/$1 [R=301,L]
 # Explicit index request: one hop to the HTTPS canonical root.
 RewriteCond %{HTTP_HOST} ^(?:www\.)?gabin\-spieser\.com$ [NC]
 RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
 RewriteRule ^index\.html$ https://gabin-spieser.com/ [R=301,L,NE]
 RewriteCond %{HTTP_HOST} ^www\.gabin\-spieser\.com$ [NC]
 RewriteRule ^ https://gabin-spieser.com%{REQUEST_URI} [R=301,L,NE]
 RewriteCond %{HTTP_HOST} ^gabin\-spieser\.com$ [NC]
 RewriteCond %{HTTPS} !=on
 RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
 RewriteRule ^ https://gabin-spieser.com%{REQUEST_URI} [R=301,L,NE]
 # Photos de l'ancien portfolio reprises à l'identique dans le nouveau (24/11/2026) : redirection permanente vers le nouveau fichier.
 # Les autres anciennes photos ont été retirées du site : leur adresse répond « introuvable » (404), ce qui est normal.
 RewriteRule ^assets/photos/(?:gabin-spieser-live-01|stomy-bugsy-concert-gabin-spieser-live-01)-small\.webp$ /assets/portfolio/stomy-bugsy/stomy-bugsy-concert-05-640.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-01|stomy-bugsy-concert-gabin-spieser-live-01)-medium\.webp$ /assets/portfolio/stomy-bugsy/stomy-bugsy-concert-05-1024.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-01|stomy-bugsy-concert-gabin-spieser-live-01)-large\.webp$ /assets/portfolio/stomy-bugsy/stomy-bugsy-concert-05-1600.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-02|lokyto-concert-gabin-spieser-live-02)-small\.webp$ /assets/portfolio/lokyto/lokyto-concert-01-640.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-02|lokyto-concert-gabin-spieser-live-02)-medium\.webp$ /assets/portfolio/lokyto/lokyto-concert-01-1024.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-02|lokyto-concert-gabin-spieser-live-02)-large\.webp$ /assets/portfolio/lokyto/lokyto-concert-01-2400.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-04|julien-dore-concert-gabin-spieser-live-04)-small\.webp$ /assets/portfolio/julien-dore/julien-dore-foire-en-scene-2026-12-640.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-04|julien-dore-concert-gabin-spieser-live-04)-medium\.webp$ /assets/portfolio/julien-dore/julien-dore-foire-en-scene-2026-12-1024.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-04|julien-dore-concert-gabin-spieser-live-04)-large\.webp$ /assets/portfolio/julien-dore/julien-dore-foire-en-scene-2026-12-2400.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-07|choriste-danna-winkin-concert-gabin-spieser-live-07)-small\.webp$ /assets/portfolio/anna-winkin/anna-winkin-wavre-2026-12-640.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-07|choriste-danna-winkin-concert-gabin-spieser-live-07)-medium\.webp$ /assets/portfolio/anna-winkin/anna-winkin-wavre-2026-12-1024.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-07|choriste-danna-winkin-concert-gabin-spieser-live-07)-large\.webp$ /assets/portfolio/anna-winkin/anna-winkin-wavre-2026-12-1491.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-10|ina-forsman-concert-gabin-spieser-live-10)-small\.webp$ /assets/portfolio/ina-forsman/ina-forsman-noir-et-blanc-13-640.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-10|ina-forsman-concert-gabin-spieser-live-10)-medium\.webp$ /assets/portfolio/ina-forsman/ina-forsman-noir-et-blanc-13-1024.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-10|ina-forsman-concert-gabin-spieser-live-10)-large\.webp$ /assets/portfolio/ina-forsman/ina-forsman-noir-et-blanc-13-1600.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-13|electro-symphony-concert-gabin-spieser-live-13)-small\.webp$ /assets/portfolio/electro-symphony/electro-symphony-reims-arena-2026-06-640.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-13|electro-symphony-concert-gabin-spieser-live-13)-medium\.webp$ /assets/portfolio/electro-symphony/electro-symphony-reims-arena-2026-06-1024.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-13|electro-symphony-concert-gabin-spieser-live-13)-large\.webp$ /assets/portfolio/electro-symphony/electro-symphony-reims-arena-2026-06-1600.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-20|electro-symphony-concert-gabin-spieser-live-20)-small\.webp$ /assets/portfolio/electro-symphony/electro-symphony-reims-arena-2026-01-640.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-20|electro-symphony-concert-gabin-spieser-live-20)-medium\.webp$ /assets/portfolio/electro-symphony/electro-symphony-reims-arena-2026-01-1024.webp [R=301,L,NE]
 RewriteRule ^assets/photos/(?:gabin-spieser-live-20|electro-symphony-concert-gabin-spieser-live-20)-large\.webp$ /assets/portfolio/electro-symphony/electro-symphony-reims-arena-2026-01-2400.webp [R=301,L,NE]
</IfModule>
<IfModule mod_deflate.c>
 AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>
<IfModule mod_mime.c>
 AddType font/woff2 .woff2
</IfModule>
<IfModule mod_headers.c>
 # Security headers. The CSP is enforced since 23/11/2026: anything not listed here is blocked by the browser.
 Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
 Header always set X-Content-Type-Options "nosniff"
 Header always set Referrer-Policy "strict-origin-when-cross-origin"
 Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
 Header always set X-Frame-Options "SAMEORIGIN"
 Header always set Cross-Origin-Opener-Policy "same-origin"
 Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.google.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
 <FilesMatch "\.(html|xml|txt)$">
  Header set Cache-Control "no-cache"
 </FilesMatch>
 <FilesMatch "\.(css|js)$">
  Header set Cache-Control "public, max-age=31536000"
 </FilesMatch>
 <FilesMatch "\.woff2$">
  Header set Cache-Control "public, max-age=31536000"
 </FilesMatch>
 <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
  Header set Cache-Control "public, max-age=2592000"
 </FilesMatch>
</IfModule>
